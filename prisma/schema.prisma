// Schema bazy danych Prismy — źródło prawdy o strukturze danych.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ════════════════════════════════════════════════════════════════
//  Profile
// ════════════════════════════════════════════════════════════════
model Profile {
  id String @id @db.Uuid

  email       String    @unique
  nickname    String?   @unique
  bio         String?
  avatarUrl   String?   @map("avatar_url")
  role        Role      @default(USER)
  permissions String[]  @default([])
  lastSeenAt  DateTime? @db.Timestamptz(3) @map("last_seen_at")
  createdAt   DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  posts                 Post[]
  postLikes             PostLike[]
  comments              Comment[]
  commentLikes          CommentLike[]
  // Powiadomienia są dwustronne — user jest "recipientem" lub "actorem"
  notificationsReceived Notification[] @relation("recipientNotifications")
  notificationsCreated  Notification[] @relation("actorNotifications")

  @@map("profiles")
}

enum Role {
  MASTER
  ADMIN
  USER
}

// ════════════════════════════════════════════════════════════════
//  Post
// ════════════════════════════════════════════════════════════════
model Post {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String    @db.VarChar(200)
  content       String    @db.Text
  imageUrl      String?   @map("image_url")
  authorId      String    @db.Uuid @map("author_id")
  author        Profile   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likesCount    Int       @default(0) @map("likes_count")
  commentsCount Int       @default(0) @map("comments_count")
  createdAt     DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")
  editedAt      DateTime? @db.Timestamptz(3) @map("edited_at")

  likes PostLike[]

  @@index([createdAt(sort: Desc)])
  @@index([authorId])
  @@map("posts")
}

// ════════════════════════════════════════════════════════════════
//  PostLike
// ════════════════════════════════════════════════════════════════
model PostLike {
  postId    String   @db.Uuid @map("post_id")
  userId    String   @db.Uuid @map("user_id")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  @@id([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

// ════════════════════════════════════════════════════════════════
//  Comment
// ════════════════════════════════════════════════════════════════
model Comment {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetType  CommentTargetType @map("target_type")
  targetId    String            @db.Uuid @map("target_id")
  authorId    String            @db.Uuid @map("author_id")
  author      Profile           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String            @db.Text
  parentId    String?           @db.Uuid @map("parent_id")
  parent      Comment?          @relation("CommentTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Comment[]         @relation("CommentTree")
  depth       Int               @default(0)
  isDeleted   Boolean           @default(false) @map("is_deleted")
  likesCount  Int               @default(0) @map("likes_count")
  createdAt   DateTime          @default(now()) @db.Timestamptz(3) @map("created_at")
  editedAt    DateTime?         @db.Timestamptz(3) @map("edited_at")

  likes CommentLike[]

  @@index([targetType, targetId])
  @@index([parentId])
  @@index([authorId])
  @@map("comments")
}

enum CommentTargetType {
  POST
}

// ════════════════════════════════════════════════════════════════
//  CommentLike
// ════════════════════════════════════════════════════════════════
model CommentLike {
  commentId String   @db.Uuid @map("comment_id")
  userId    String   @db.Uuid @map("user_id")
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_likes")
}

// ════════════════════════════════════════════════════════════════
//  Notification — system powiadomień
// ════════════════════════════════════════════════════════════════
// recipient — komu się wyświetli powiadomienie
// actor     — kto wykonał akcję (może być null gdy system)
// type      — rodzaj zdarzenia (COMMENT_ON_POST, REPLY_TO_COMMENT, ...)
// source    — co jest źródłem (polimorficzne: 'comment' + id komentarza)
// is_read   — czy user już je przeczytał
//
// Tworzone automatycznie przez triggery SQL (create_comment_notification).
// User nigdy nie wstawia bezpośrednio (brak polityki RLS INSERT).
model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String           @db.Uuid @map("recipient_id")
  recipient   Profile          @relation("recipientNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?          @db.Uuid @map("actor_id")
  actor       Profile?         @relation("actorNotifications", fields: [actorId], references: [id], onDelete: SetNull)
  type        NotificationType
  sourceType  String?          @db.VarChar(50) @map("source_type")
  sourceId    String?          @db.Uuid @map("source_id")
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @db.Timestamptz(3) @map("created_at")

  @@index([recipientId, isRead])
  @@index([recipientId, createdAt(sort: Desc)])
  @@map("notifications")
}

enum NotificationType {
  COMMENT_ON_POST      // ktoś skomentował Twój post
  REPLY_TO_COMMENT     // ktoś odpowiedział na Twój komentarz
  // Future: LIKE_ON_POST, LIKE_ON_COMMENT, MENTION, ADMIN_ACTION
}
