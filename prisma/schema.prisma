// Schema bazy danych Prismy — źródło prawdy o strukturze danych.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ════════════════════════════════════════════════════════════════
//  Profile
// ════════════════════════════════════════════════════════════════
model Profile {
  id String @id @db.Uuid

  email       String    @unique
  nickname    String?   @unique
  bio         String?
  avatarUrl   String?   @map("avatar_url")
  role        Role      @default(USER)
  permissions String[]  @default([])
  lastSeenAt  DateTime? @db.Timestamptz(3) @map("last_seen_at")
  createdAt   DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  posts        Post[]
  postLikes    PostLike[]
  comments     Comment[]
  commentLikes CommentLike[]

  @@map("profiles")
}

enum Role {
  MASTER
  ADMIN
  USER
}

// ════════════════════════════════════════════════════════════════
//  Post
// ════════════════════════════════════════════════════════════════
model Post {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String    @db.VarChar(200)
  content       String    @db.Text
  imageUrl      String?   @map("image_url")
  authorId      String    @db.Uuid @map("author_id")
  author        Profile   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likesCount    Int       @default(0) @map("likes_count")
  commentsCount Int       @default(0) @map("comments_count")
  createdAt     DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")
  editedAt      DateTime? @db.Timestamptz(3) @map("edited_at")

  likes PostLike[]

  @@index([createdAt(sort: Desc)])
  @@index([authorId])
  @@map("posts")
}

// ════════════════════════════════════════════════════════════════
//  PostLike
// ════════════════════════════════════════════════════════════════
model PostLike {
  postId    String   @db.Uuid @map("post_id")
  userId    String   @db.Uuid @map("user_id")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  @@id([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

// ════════════════════════════════════════════════════════════════
//  Comment — polimorficzny
// ════════════════════════════════════════════════════════════════
model Comment {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetType  CommentTargetType @map("target_type")
  targetId    String            @db.Uuid @map("target_id")
  authorId    String            @db.Uuid @map("author_id")
  author      Profile           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String            @db.Text
  parentId    String?           @db.Uuid @map("parent_id")
  parent      Comment?          @relation("CommentTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Comment[]         @relation("CommentTree")
  depth       Int               @default(0)
  isDeleted   Boolean           @default(false) @map("is_deleted")
  // Denormalizowany licznik lajków — trigger update_comment_likes_count()
  likesCount  Int               @default(0) @map("likes_count")
  createdAt   DateTime          @default(now()) @db.Timestamptz(3) @map("created_at")
  editedAt    DateTime?         @db.Timestamptz(3) @map("edited_at")

  likes CommentLike[]

  @@index([targetType, targetId])
  @@index([parentId])
  @@index([authorId])
  @@map("comments")
}

enum CommentTargetType {
  POST
}

// ════════════════════════════════════════════════════════════════
//  CommentLike — junction many-to-many (analogicznie do PostLike)
// ════════════════════════════════════════════════════════════════
model CommentLike {
  commentId String   @db.Uuid @map("comment_id")
  userId    String   @db.Uuid @map("user_id")
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_likes")
}
