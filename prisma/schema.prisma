// Schema bazy danych Prismy — źródło prawdy o strukturze danych.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ════════════════════════════════════════════════════════════════
//  Profile
// ════════════════════════════════════════════════════════════════
model Profile {
  id String @id @db.Uuid

  email       String    @unique
  nickname    String?   @unique
  bio         String?
  avatarUrl   String?   @map("avatar_url")
  role        Role      @default(USER)
  permissions String[]  @default([])
  lastSeenAt  DateTime? @db.Timestamptz(3) @map("last_seen_at")
  createdAt   DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  posts                 Post[]
  postLikes             PostLike[]
  comments              Comment[]
  commentLikes          CommentLike[]
  notificationsReceived Notification[] @relation("recipientNotifications")
  notificationsCreated  Notification[] @relation("actorNotifications")
  tagsCreated           Tag[]
  conversationsAsUser1  Conversation[] @relation("conversationsAsUser1")
  conversationsAsUser2  Conversation[] @relation("conversationsAsUser2")
  messagesSent          Message[]      @relation("messagesSent")
  messagesReceived      Message[]      @relation("messagesReceived")
  blocksMade            BlockedUser[]  @relation("blocksMade")
  blocksReceived        BlockedUser[]  @relation("blocksReceived")

  @@map("profiles")
}

enum Role {
  MASTER
  ADMIN
  USER
}

// ════════════════════════════════════════════════════════════════
//  Post
// ════════════════════════════════════════════════════════════════
model Post {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String    @db.VarChar(200)
  content       String    @db.Text
  imageUrl      String?   @map("image_url")
  authorId      String    @db.Uuid @map("author_id")
  author        Profile   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likesCount    Int       @default(0) @map("likes_count")
  commentsCount Int       @default(0) @map("comments_count")
  createdAt     DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")
  editedAt      DateTime? @db.Timestamptz(3) @map("edited_at")

  // Kolumna pełnotekstowa do wyszukiwarki (typ Postgres `tsvector`).
  // Prisma nie obsługuje tsvector natywnie → typ Unsupported (Prisma jej
  // nie czyta ani nie zapisuje). Wartość utrzymuje trigger SQL
  // `trg_posts_search_vector`. Indeks GIN tworzony jest w SQL.sql.
  searchVector Unsupported("tsvector")? @map("search_vector")

  likes    PostLike[]
  postTags PostTag[]

  @@index([createdAt(sort: Desc)])
  @@index([authorId])
  @@map("posts")
}

model PostLike {
  postId    String   @db.Uuid @map("post_id")
  userId    String   @db.Uuid @map("user_id")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  @@id([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

// ════════════════════════════════════════════════════════════════
//  Comment
// ════════════════════════════════════════════════════════════════
model Comment {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetType  CommentTargetType @map("target_type")
  targetId    String            @db.Uuid @map("target_id")
  authorId    String            @db.Uuid @map("author_id")
  author      Profile           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String            @db.Text
  parentId    String?           @db.Uuid @map("parent_id")
  parent      Comment?          @relation("CommentTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Comment[]         @relation("CommentTree")
  depth       Int               @default(0)
  isDeleted   Boolean           @default(false) @map("is_deleted")
  likesCount  Int               @default(0) @map("likes_count")
  createdAt   DateTime          @default(now()) @db.Timestamptz(3) @map("created_at")
  editedAt    DateTime?         @db.Timestamptz(3) @map("edited_at")
  likes       CommentLike[]
  @@index([targetType, targetId])
  @@index([parentId])
  @@index([authorId])
  @@map("comments")
}

enum CommentTargetType {
  POST
}

model CommentLike {
  commentId String   @db.Uuid @map("comment_id")
  userId    String   @db.Uuid @map("user_id")
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_likes")
}

// ════════════════════════════════════════════════════════════════
//  Notification
// ════════════════════════════════════════════════════════════════
model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String           @db.Uuid @map("recipient_id")
  recipient   Profile          @relation("recipientNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?          @db.Uuid @map("actor_id")
  actor       Profile?         @relation("actorNotifications", fields: [actorId], references: [id], onDelete: SetNull)
  type        NotificationType
  sourceType  String?          @db.VarChar(50) @map("source_type")
  sourceId    String?          @db.Uuid @map("source_id")
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @db.Timestamptz(3) @map("created_at")
  @@index([recipientId, isRead])
  @@index([recipientId, createdAt(sort: Desc)])
  @@map("notifications")
}

enum NotificationType {
  COMMENT_ON_POST
  REPLY_TO_COMMENT
}

// ════════════════════════════════════════════════════════════════
//  Tag — tematyczna etykieta postów
// ════════════════════════════════════════════════════════════════
model Tag {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(50)
  slug        String   @unique @db.VarChar(60)
  color       String?  @db.VarChar(20)
  description String?
  createdById String?  @db.Uuid @map("created_by_id")
  createdBy   Profile? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  postTags PostTag[]

  @@index([slug])
  @@map("tags")
}

// ════════════════════════════════════════════════════════════════
//  PostTag — junction many-to-many (post ↔ tag)
// ════════════════════════════════════════════════════════════════
model PostTag {
  postId    String   @db.Uuid @map("post_id")
  tagId     String   @db.Uuid @map("tag_id")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

// ════════════════════════════════════════════════════════════════
//  Conversation — rozmowa prywatna 1:1
// ════════════════════════════════════════════════════════════════
// Kanonicznie: user1Id < user2Id (porządek leksykalny UUID). Dzięki temu
// para uczestników jest unikalna i łatwo znaleźć istniejącą rozmowę.
model Conversation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user1Id   String   @db.Uuid @map("user1_id")
  user2Id   String   @db.Uuid @map("user2_id")
  user1     Profile  @relation("conversationsAsUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     Profile  @relation("conversationsAsUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  messages Message[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@map("conversations")
}

// ════════════════════════════════════════════════════════════════
//  Message — pojedyncza wiadomość
// ════════════════════════════════════════════════════════════════
// recipientId jest zdenormalizowany (w 1:1 to zawsze drugi uczestnik) —
// dzięki temu licznik nieprzeczytanych to proste WHERE recipient_id = ja.
model Message {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @db.Uuid @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @db.Uuid @map("sender_id")
  recipientId    String       @db.Uuid @map("recipient_id")
  sender         Profile      @relation("messagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient      Profile      @relation("messagesReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  content        String       @db.Text
  readAt         DateTime?    @db.Timestamptz(3) @map("read_at")
  createdAt      DateTime     @default(now()) @db.Timestamptz(3) @map("created_at")

  @@index([conversationId, createdAt])
  @@index([recipientId, readAt])
  @@map("messages")
}

// ════════════════════════════════════════════════════════════════
//  BlockedUser — blokady (blocker zablokował blocked)
// ════════════════════════════════════════════════════════════════
model BlockedUser {
  blockerId String   @db.Uuid @map("blocker_id")
  blockedId String   @db.Uuid @map("blocked_id")
  blocker   Profile  @relation("blocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   Profile  @relation("blocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocked_users")
}
