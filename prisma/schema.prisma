// Schema bazy danych Prismy — źródło prawdy o strukturze danych.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ════════════════════════════════════════════════════════════════
//  Profile
// ════════════════════════════════════════════════════════════════
model Profile {
  id String @id @db.Uuid

  email       String    @unique
  // nickname unikalna w całym serwisie. Wartości NULL są dopuszczone wielokrotnie
  // (Postgres traktuje NULL-e jako różne w UNIQUE), więc świeży user bez ksywki
  // nie blokuje innych — limit dotyczy tylko ustawionych ksywek.
  nickname    String?   @unique
  bio         String?
  avatarUrl   String?   @map("avatar_url")
  role        Role      @default(USER)
  permissions String[]  @default([])
  lastSeenAt  DateTime? @db.Timestamptz(3) @map("last_seen_at")
  createdAt   DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  posts Post[]

  @@map("profiles")
}

enum Role {
  MASTER
  ADMIN
  USER
}

// ════════════════════════════════════════════════════════════════
//  Post
// ════════════════════════════════════════════════════════════════
model Post {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String    @db.VarChar(200)
  content   String    @db.Text
  imageUrl  String?   @map("image_url")
  authorId  String    @db.Uuid @map("author_id")
  author    Profile   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")
  editedAt  DateTime? @db.Timestamptz(3) @map("edited_at")

  @@index([createdAt(sort: Desc)])
  @@index([authorId])
  @@map("posts")
}
